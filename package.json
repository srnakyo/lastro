{
  "name": "lastro-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun test --preload ./tests/setup/preload.ts tests/unit tests/integration",
    "test:unit": "bun test --preload ./tests/setup/preload.ts tests/unit",
    "test:integration": "bun test --preload ./tests/setup/preload.ts tests/integration",
    "db:generate": "bun --filter @lastro/database generate",
    "db:migrate": "bun --filter @lastro/database migrate",
    "audit": "bun audit"
  },
  "packageManager": "bun@1.3.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lastro/core": "workspace:*",
    "@lastro/database": "workspace:*",
    "@lastro/eslint-config": "workspace:*",
    "@lastro/intake": "workspace:*",
    "@lastro/runner": "workspace:*",
    "@lastro/shared": "workspace:*",
    "@lastro/snapshot": "workspace:*",
    "@lastro/storage": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.5",
    "docx": "^9.16.0",
    "eslint": "^10.15.0",
    "pdf-lib": "^1.17.1",
    "turbo": "^2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}

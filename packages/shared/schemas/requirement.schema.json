{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srnakyo/lastro/schemas/requirement.schema.json",
  "title": ".lastro/requirements/REQ-*.yml",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{5}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "captured",
        "specified",
        "approved",
        "building",
        "verified",
        "previewed",
        "delivered",
        "accepted",
        "reopened",
        "dropped"
      ]
    },
    "package": {
      "type": "string",
      "pattern": "^PKG-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{5}$"
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^SRC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{5}$"
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ref",
          "anchor",
          "quote"
        ]
      }
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "where": {
      "type": "string"
    },
    "who": {
      "type": "object",
      "properties": {
        "sees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "data_source": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "reach": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "visual_ref": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "when_missing": {
      "type": "string"
    },
    "examples": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "given": {
            "type": "string"
          },
          "expect": {
            "type": "string"
          }
        },
        "required": [
          "given",
          "expect"
        ]
      }
    },
    "acceptance": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-\\d+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "tests": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locked": {
            "type": [
              "string",
              "null"
            ]
          },
          "locked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    },
    "decisions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DEC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{5}$"
      }
    },
    "questions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^Q-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{5}$"
      }
    },
    "depends_on": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{5}$"
      }
    },
    "touches": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "status",
    "sources",
    "statement",
    "acceptance"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srnakyo/lastro/schemas/config.schema.json",
  "title": ".lastro/lastro.yml",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "default": "en",
      "type": "string",
      "enum": [
        "en",
        "pt-BR"
      ]
    },
    "autonomy": {
      "default": "auto",
      "type": "string",
      "enum": [
        "auto",
        "review"
      ]
    },
    "tests": {
      "default": {
        "levels": {
          "e2e": [
            "tests/e2e/**",
            "e2e/**",
            "**/*.spec.*"
          ],
          "integration": [
            "tests/integration/**",
            "**/*.integration.*"
          ],
          "unit": [
            "tests/unit/**",
            "**/*.test.*",
            "**/__tests__/**"
          ]
        },
        "red_first": false,
        "examples_in_tests": false,
        "coverage_exclude": []
      },
      "type": "object",
      "properties": {
        "levels": {
          "default": {
            "e2e": [
              "tests/e2e/**",
              "e2e/**",
              "**/*.spec.*"
            ],
            "integration": [
              "tests/integration/**",
              "**/*.integration.*"
            ],
            "unit": [
              "tests/unit/**",
              "**/*.test.*",
              "**/__tests__/**"
            ]
          },
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "red_first": {
          "default": false,
          "type": "boolean"
        },
        "red_first_since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "examples_in_tests": {
          "default": false,
          "type": "boolean"
        },
        "coverage_report": {
          "type": "string"
        },
        "coverage_exclude": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "default": {
        "spec": [
          "dev"
        ],
        "require_final_source": false
      },
      "type": "object",
      "properties": {
        "spec": {
          "default": [
            "dev"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require_final_source": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "commands": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "run": {
            "type": "string"
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "report": {
            "type": "object",
            "properties": {
              "junit": {
                "type": "string"
              },
              "sarif": {
                "type": "string"
              },
              "junit_prefix": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "run"
        ]
      }
    },
    "conditions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "setup": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "types": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "flow": {
            "default": [],
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "run": {
                      "type": "string"
                    },
                    "check": {
                      "type": "string"
                    },
                    "conditions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "manual": {
                      "type": "boolean"
                    },
                    "by": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "tests": {
            "default": {
              "levels": []
            },
            "type": "object",
            "properties": {
              "levels": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "functions": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "lines": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        }
      }
    },
    "global_flow": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "run": {
                "type": "string"
              },
              "check": {
                "type": "string"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "manual": {
                "type": "boolean"
              },
              "by": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "gate": {
      "default": {
        "block_agent_stop": true,
        "stale_on_change": true,
        "max_stop_blocks": 3,
        "ci": "required",
        "human_identities": []
      },
      "type": "object",
      "properties": {
        "block_agent_stop": {
          "default": true,
          "type": "boolean"
        },
        "stale_on_change": {
          "default": true,
          "type": "boolean"
        },
        "max_stop_blocks": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ci": {
          "default": "required",
          "type": "string",
          "enum": [
            "required",
            "optional",
            "off"
          ]
        },
        "human_identities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "url_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "token_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    }
  },
  "required": [
    "project"
  ]
}

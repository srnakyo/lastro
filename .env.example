# Copy to .env. Never commit .env.

# The address people open in the browser (also the auth callback base).
LASTRO_URL=http://localhost:4317
# A long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Development: your own Postgres. In docker/compose.prod.yml the URL is built from POSTGRES_PASSWORD.
LASTRO_DATABASE_URL=postgresql://lastro:lastro@localhost:5433/lastro
LASTRO_TEST_DATABASE_URL=postgresql://lastro:lastro@localhost:5433/lastro_test
POSTGRES_PASSWORD=

# Optional: sign in with GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where source files, images and documents are kept: local (default) or s3.
LASTRO_STORAGE=local
LASTRO_STORAGE_DIR=
LASTRO_S3_ENDPOINT=
LASTRO_S3_REGION=
LASTRO_S3_BUCKET=
LASTRO_S3_ACCESS_KEY_ID=
LASTRO_S3_SECRET_ACCESS_KEY=

# Optional: audio and video intake (Lastro embeds no model).
# A command with {input} and {output_dir} that writes Whisper-style JSON, e.g.:
# LASTRO_TRANSCRIBE_COMMAND=whisper {input} --output_format json --output_dir {output_dir}
LASTRO_TRANSCRIBE_COMMAND=
LASTRO_FFMPEG=ffmpeg
